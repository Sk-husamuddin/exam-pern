# ============================================================
# Smart Exam Platform — .gitignore
# ============================================================

# --- Environment variables (SENSITIVE — never commit) ---
.env
.env.local
.env.*.local
.env.example

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build outputs ---
dist/
build/
*.local

# --- Vite / frontend ---
.vite/
frontend/dist/
frontend/.vite/

# --- Backend ---
backend/dist/
backend/build/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Misc ---
*.tsbuildinfo
coverage/
.nyc_output/

# --- Supabase local (if using Supabase CLI locally) ---
.supabase/

# --- Temporary uploads ---
backend/uploads/
