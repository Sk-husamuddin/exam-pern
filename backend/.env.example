# Copy this file to .env and fill in your Supabase values

PORT=5000
BASE_URL=http://localhost:5000

# Supabase (get from Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct PostgreSQL connection (get from Settings > Database > Connection string)
# Example: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# JWT for custom student sessions
STUDENT_JWT_SECRET=change_this_to_a_random_string

# File upload limits (bytes)
MAX_DOCX_SIZE=5242880
MAX_XLSX_SIZE=2097152
